#!/usr/bin/env bash
# cs2lm launcher for CS2 slim server (Linux).
# Runs the bundled cs2-link-manager source (tools/cs2lm/src) with python.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

PY=""
for c in python3 python; do
  if command -v "$c" >/dev/null 2>&1; then
    PY="$c"
    break
  fi
done
if [ -z "$PY" ]; then
  echo "cs2lm: 未找到 python3/python（需要 Python 3.11+）" >&2
  exit 1
fi
if ! "$PY" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1; then
  echo "cs2lm: 需要 Python 3.11+（当前: $("$PY" --version 2>&1)）" >&2
  exit 1
fi

export PYTHONPATH="$DIR/tools/cs2lm/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" -m cs2lm "$@"