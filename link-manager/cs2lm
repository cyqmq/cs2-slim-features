#!/usr/bin/env bash
# cs2lm launcher for CS2 slim server (Linux).
# Runs the bundled cs2-link-manager source (tools/cs2lm/src) with python3.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if ! command -v python3 >/dev/null 2>&1; then
  echo "cs2lm: python3 未在 PATH 中找到（需要 Python 3.11+）" >&2
  exit 1
fi
if ! python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1; then
  echo "cs2lm: 需要 Python 3.11+（当前: $(python3 --version 2>&1)）" >&2
  exit 1
fi

export PYTHONPATH="$DIR/tools/cs2lm/src${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m cs2lm "$@"